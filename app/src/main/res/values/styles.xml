<resources>

    <style name="Theme.SetSignal" parent="@android:style/Theme.DeviceDefault">
        <item name="android:windowBackground">#070806</item>
        <item name="android:colorAccent">#C8F45A</item>
        <item name="android:navigationBarColor">#070806</item>
        <item name="android:statusBarColor">#070806</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="MainActivityTheme.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#070806</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.SetSignal</item>
    </style>
</resources>
